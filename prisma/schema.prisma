generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Board {
  id            String        @id @default(uuid())
  name          String
  academicYear  String
  gradingRules  GradingRule[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  exams         Exam[]
}

model GradingRule {
  id        String   @id @default(uuid())
  boardId   String
  minMarks  Float
  maxMarks  Float
  grade     String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  @@index([boardId]) 
}


model Exam {
  id            String   @id @default(uuid())
  name          String
  academicYear  String
  board         Board    @relation(fields: [boardId], references: [id])
  boardId       String
  createdAt     DateTime @default(now())
  examSubjects ExamSubject[]
  studentResults StudentResult[]
  @@index([boardId])
}


model ExamSubject {
  id            String   @id @default(uuid())
  subjectName   String
  maxMarks      Int
  internalMarks Int
  externalMarks Int

  exam          Exam     @relation(fields: [examId], references: [id])
  examId        String

  studentResults StudentResult[]
  createdAt     DateTime @default(now())
}


model StudentResult {
  id         String   @id @default(uuid())
  studentName String
  marks      Float

  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  examSubjectId String

  exam          Exam        @relation(fields: [examId], references: [id])
  examId        String

  percentage Float?
  grade      String?

  createdAt  DateTime @default(now())
  @@index([examId])
  @@index([studentName])
}



model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHER
}